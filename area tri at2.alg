algoritmo "triangulo"
// Função :
// Autor :
// Data : 01/04/2026
// Seção de Declarações 
var
area , base , altura : real
inicio
Escreva("Digite o valor da base do triângulo : " )
Leia(base)
Escreva("Digite o valor da altura : " )
Leia(altura)
area<-(base*altura)/2
Escreva("A área do triângulo é de : " , area)
fimalgoritmo
