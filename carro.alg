algoritmo "carro"
// Função :
// Autor :
// Data : 19/03/2026
// Seção de Declarações 
var
distribuidor , imposto , custofinal , cf : real
inicio
Escreva("Digite o custo de fabricação : " )
Leia(cf)
distribuidor<-(cf*28)/100
imposto<-(cf*45)/100
custofinal<-cf+distribuidor+imposto
Escreva("O custo final para o consumidor é de : " , custofinal)
fimalgoritmo
