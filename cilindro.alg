algoritmo "cilindro"
// Função :
// Autor :
// Data : 31/03/2026
// Seção de Declarações 
var
volume , raio , altura : real
inicio
Escreva("Digite o valor do raio : " )
Leia(raio)
Escreva("Digite o valor da altura : ")
Leia(altura)
volume<-3.14*raio*raio*altura
Escreva("O valor do volume do cilindro é mde : " , volume )
fimalgoritmo
