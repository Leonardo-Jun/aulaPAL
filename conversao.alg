algoritmo "conversao combial"
// Função :
// Autor :
// Data : 01/04/2026
// Seção de Declarações 
var
reais , dolares : real
inicio
Escreva("Digite a quantia que quer converter : " )
Leia(dolares)
reais<-dolares*5.29
Escreva("O resultado da conversão de dólares para reais é de : " , reais)
fimalgoritmo
