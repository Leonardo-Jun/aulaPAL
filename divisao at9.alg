algoritmo "dividido maior"
// Função :
// Autor :
// Data : 26/03/2026
// Seção de Declarações 
var
nmaior , nmenor , divisao : real
inicio
Escreva("Digite o número maior: " )
Leia(nmaior)
Escreva("Digite o número menor: " )
Leia(nmenor)
divisao<-nmaior/nmenor
Escreva("O resultado será : " , divisao)
fimalgoritmo
