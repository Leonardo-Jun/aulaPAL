algoritmo "Divisão"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
divisao, numero1,numero2: real
inicio
Escreva("Digite o primeiro número : " )
Leia(numero1)
Escreva("Digite o segundo núumero : " )
Leia(numero2)
divisao <- numero1/numero2
Escreva("O resultado da divisão é : " , divisao)
fimalgoritmo
