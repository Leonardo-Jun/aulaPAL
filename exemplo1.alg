algoritmo "exemplonome"
// Função :
// Autor :  Leonardo
// Data : 27/02/2026
// Seção de Declarações 
var
  nome:caracter
  idade:inteiro
inicio
escreva("digite seu nome: ")
leia(nome)
EScreva("Digite a sua idade : ")
Leia(idade)
escreva("o nome digita foi:")
escreva(nome)
Escreva("A sua idade é " , idade)
fimalgoritmo
