algoritmo "imc"
// Função :
// Autor :
// Data : 01/04/2026
// Seção de Declarações 
var
imc , peso , altura : real
inicio
Escreva("Digite o peso da pessoa : " )
Leia(peso)
Escreva("Digite a altura da pessoa : " )
Leia(altura)
imc<-peso/(altura^2)
Escreva("O IMC da pessoa é de : " , imc )
fimalgoritmo
