algoritmo "semnome"
// Função :
// Autor :
// Data : 24/03/2026
// Seção de Declarações 
var
imc , peso , altura : real
inicio
Escreva("Digite o peso da pessoa : " )
Leia(peso)
Escreva("Digite a altura da pessoa : " )
Leia(altura)
imc<-peso/(altura^2)
eSCREVA("O resultado do IMC é de : " , imc )
fimalgoritmo
