algoritmo "retangulo"
// Função :
// Autor :
// Data : 19/03/2026
// Seção de Declarações 
var
area , a , b , perimetro : real
inicio
Escreva("Digite o valor do lado A : " )
Leia(a)
Escreva("Digite o valor do ladoB : " )
Leia(b)
area<-a*b
perimetro<-2*a+2*b
Escreval("O resultado da área é de : " , area)
Escreval("O resultado do perímetro é de : " , perimetro)
fimalgoritmo
