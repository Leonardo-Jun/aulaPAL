algoritmo "pessoa"
// Função :
// Autor :
// Data : 10/03/2026
// Seção de Declarações 
var
nome : caracter
idade , diasvividos : real
inicio
Escreva("Digite o nome da pessoa :" )
Leia(nome)
Escreva("Digite a idade da pessoa :" )
Leia(idade)
diasvividos<-idade*365
Escreva(nome,"vocÊ viveu" ,diasvividos,"dias")
fimalgoritmo
