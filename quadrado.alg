algoritmo "AoQuadrado"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
numero1 , quadrado : inteiro
inicio
Escreva("Digite o número : )
Leia(numero1)
Escreva("Digite o nú mero : )
Leia(numero1)
quadrado<-numero1*numero1
Escreva("O resultado do número : ", quadrado )
fimalgoritmo
