algoritmo "conversão"
// Função :
// Autor :
// Data : 24/03/2026
// Seção de Declarações 
var
reais , dolar : real
inicio
Escreva("Digite a quantidade de dólar que quer conveter : " )
Leia(dolar)
reais<-dolar*5.29
Escreva("O resultado da conversão de dólar para real é de : " , reais )
fimalgoritmo
