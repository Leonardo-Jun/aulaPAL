algoritmo "aumento salarial d"
// Função :
// Autor :
// Data : 17/03/2026
// Seção de Declarações 
var
novosalario , salario : real
inicio
Escreva("Digite o salário do funcionário : " )
Leia(salario)
novosalario<-salario+(salario*25/100)
Escreva("O valor do aumento salarial vai resultar em : " , novosalario )
fimalgoritmo
