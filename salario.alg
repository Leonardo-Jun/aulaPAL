algoritmo "salario"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações 
var
novosalario , salario , percentual : real
inicio
Escreva("Digite a primeira palavra : " )
Leia(salario)
Escreva("Digite a segunda palavra : " )
Leia(percentual)
novosalario<-salario+(salario*percentual)/100
Escreva("O salário mensal do funcinário é : " ,  novosalario )
fimalgoritmo
