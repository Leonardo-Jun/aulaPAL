algoritmo "soma"
// Função :
// Autor :  Leonardo
// Data : 27/02/2026
// Seção de Declarações 
var
soma,numero1, numero2 : inteiro
inicio
Escreva("Digite o primeiro número: ")
Leia(numero1)
Escreva("Digite o segundo número: ")
Leia(numero2)
soma <- numero1 + numero2
Escreva("o resultado da soma é " , soma)
fimalgoritmo
