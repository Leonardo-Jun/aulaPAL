algoritmo "menos"
// Função :
// Autor :
// Data : 03/03/2026
// Seção de Declarações 
var
subtracao, numero1, numero2 : inteiro
inicio
Escreva("Digite o primeiro número: ")
Leia(numero1)
Escreva("Digite o segundo número: ")
Leia(numero2)
subtracao <- numero1-numero2
Escreva("O resultado da subtração é" , )
fimalgoritmo
