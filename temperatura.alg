algoritmo "semnome"
// Função :
// Autor :
// Data : 18/03/2026
// Seção de Declarações 
var
celsius , fahrenheit : real
inicio
Escreva("Digite a temepratura em celsius : " )
Leia(celsius)
fahrenheit<-celsius*1.8+32
Escreva("O resultado da conversão de celsius em fahrenheit é de : " , fahrenheit )
fimalgoritmo
