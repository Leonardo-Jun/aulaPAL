algoritmo "base"
// Função :
// Autor :
// Data : 24/03/2026
// Seção de Declarações 
var
area , base , altura : real
inicio
Escreva("Digite o valor da base : " )
Leia(base)
Escreva("DIgite o valor da altura : " )
Leia(altura)
area<-(base*altura)/2
Escreva("O valor da área do triângulo é de : " , area )
fimalgoritmo
